{
  "BackgroundProcessing": {
    "Enabled": true,
    "PollingIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@secureflow.local",
    "FromName": "SecureFlow",
    "EnableSsl": false,
    "TimeoutMilliseconds": 30000
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Invitations": {
    "ExpirationHours": 72
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SecureFlow.Api"
    }
  }
}
