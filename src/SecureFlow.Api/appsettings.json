{
  "Telemetry": {
    "ExportEnabled": false,
    "Endpoint": "",
    "Headers": "",
    "TraceRatio": 1.0
  },
  "BackgroundProcessing": {
    "Enabled": true,
    "PollingIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 100,
    "MaxAttempts": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "127.0.0.1:6379"
  },
  "Caching": {
    "Enabled": true,
    "PermissionTtlSeconds": 60,
    "OrganizationSettingsTtlSeconds": 300,
    "DashboardTtlSeconds": 30,
    "OperationTimeoutMilliseconds": 500
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@secureflow.local",
    "FromName": "SecureFlow",
    "EnableSsl": false,
    "TimeoutMilliseconds": 30000
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Invitations": {
    "ExpirationHours": 72
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SecureFlow.Api"
    }
  }
}
