# Local development example only. Copy to .env; never commit the resulting .env.
# These are public dummy credentials, NOT production keys. Use only on localhost.
# Keep this template free of personal data, real SMTP credentials and API tokens.
# Do not overwrite an existing .env or reuse production data volumes.
#
# Docker Compose reads .env automatically. API Debug/Development fills only missing
# settings from it; environment/CLI/appsettings values retain precedence.
# The API .env loader does NOT expand variable references.

# PostgreSQL: POSTGRES_PASSWORD and the connection-string Password must match.
POSTGRES_DB=secureflow
POSTGRES_USER=secureflow
POSTGRES_PASSWORD=local-postgres-password
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=secureflow;Username=secureflow;Password=local-postgres-password"

# RustFS: MINIO_* names are compatibility aliases used by docker-compose.yml.
# Keep these in sync with ObjectStorage__AccessKey and ObjectStorage__SecretKey.
# Reusing the storage admin account is for disposable local development only.
MINIO_ROOT_USER=secureflow-dev
MINIO_ROOT_PASSWORD=local-storage-password
ObjectStorage__ServiceUrl=http://localhost:9000
ObjectStorage__AccessKey=secureflow-dev
ObjectStorage__SecretKey=local-storage-password
ObjectStorage__BucketName=secureflow-attachments
ObjectStorage__Region=us-east-1
ObjectStorage__CreateBucketIfMissing=true

# Redis is loopback-only in development; no public exposure or production reuse.
ConnectionStrings__Redis=127.0.0.1:6379

# Local SMTP uses appsettings defaults: localhost:1025, no SMTP credentials.
# Read registration, password reset and invitation emails at http://localhost:8025.
# API: http://localhost:5080; frontend: http://localhost:5173.
#
# Production uses compose.production.yml and externally mounted secret files,
# not this template. Prepare separate DB/Redis/S3/SMTP credentials and TLS plus
# Data Protection certificates. Never paste those values into this example.
