server {
    listen 8080 default_server;
    server_name _;
    location = /health/live { access_log off; return 200 'Healthy'; }
    location / { return 444; }
}
server {
    listen 8080;
    server_name ${SERVER_NAME};
    location = /health/live { return 200 'Healthy'; }
    location / { return 308 https://${SERVER_NAME}:${HTTPS_PORT}$request_uri; }
}
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 8443 ssl;
    server_name ${SERVER_NAME};
    ssl_certificate /run/tls/fullchain.pem;
    ssl_certificate_key /run/tls/privatekey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    root /usr/share/nginx/html;
    include /etc/nginx/security-headers.conf;
    client_max_body_size 11m;
    client_body_timeout 30s;
    send_timeout 60s;

    location ~ ^/(api|hubs|health)(/|$) {
        set $api http://api:8080;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Original-For "";
        proxy_set_header X-Original-Proto "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cache-Control;
        # Preserve API's stricter policy, including edge-generated 413/502 responses.
        include /etc/nginx/api-security-headers.conf;
    }
    location ~ /\. { return 404; }
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        try_files $uri /index.html;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }
}
