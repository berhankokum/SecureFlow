{
  "AllowedHosts": "app.example.com",
  "Frontend": { "BaseUrl": "https://app.example.com" },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Database=secureflow;Username=secureflow_app;Password=REPLACE_WITH_APP_DB_SECRET",
    "Redis": "redis:6379,password=REPLACE_WITH_REDIS_SECRET,abortConnect=false"
  },
  "Production": {
    "KnownProxies": ["172.30.27.2"],
    "KeysPath": "/var/lib/secureflow/keys",
    "KeyCertificatePath": "/run/secureflow/protection.pfx",
    "KeyCertificatePassword": "REPLACE_WITH_CERTIFICATE_SECRET"
  },
  "ObjectStorage": {
    "ServiceUrl": "http://object-storage:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "secureflow-attachments",
    "Region": "us-east-1",
    "CreateBucketIfMissing": false
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "noreply@example.com",
    "Username": "REPLACE_WITH_SMTP_USER",
    "Password": "REPLACE_WITH_SMTP_SECRET"
  }
}
