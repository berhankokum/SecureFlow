# Non-secret deployment interpolation; use --env-file explicitly.
PRODUCTION_HOST=app.example.com
PRODUCTION_SECRETS_DIR=/srv/secureflow/secrets
# Loopback by default. Public binding is a deliberate Phase 29 deployment decision.
PRODUCTION_BIND_ADDRESS=127.0.0.1
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_PORT=443
PRODUCTION_PROXY_SUBNET=172.30.27.0/29
PRODUCTION_PROXY_IP=172.30.27.2
PRODUCTION_API_IP=172.30.27.3
